# RegNav Frontend Environment Configuration
#
# Copy this file to `.env.local` for local development. Never commit real
# secrets. In production these values are injected by the build pipeline /
# hosting platform.

# Base URL of the RegNav backend API gateway. The Vite dev server proxies
# /api/* to this address (see vite.config.ts).
VITE_API_BASE_URL=http://localhost:8000

# Azure AD B2C OIDC authority URL (e.g. https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>)
VITE_AUTH_AUTHORITY=

# Azure AD B2C application (client) ID for the SPA registration
VITE_AUTH_CLIENT_ID=

# API scope requested during sign-in (e.g. https://<tenant>.onmicrosoft.com/api/access_as_user)
VITE_AUTH_API_SCOPE=

# Logical environment name surfaced in the UI / telemetry tags
VITE_APP_ENV=development
