# RegNav Backend Environment Configuration
#
# Copy to `.env` for local development. Production values come from
# Azure Key Vault via Managed Service Identity — never commit real
# secrets to this file.

APP_NAME=RegNav API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Frontend dev server origins (comma-separated JSON array works too)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://regnav:regnav@localhost:5432/regnav
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Azure AD B2C (leave blank in dev; required in staging/prod)
AZURE_AD_B2C_TENANT=
AZURE_AD_B2C_CLIENT_ID=
AZURE_AD_B2C_POLICY=
JWT_AUDIENCE=
JWT_ALGORITHM=RS256

# Azure resources
AZURE_KEYVAULT_URL=
AZURE_OPENAI_ENDPOINT=

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
