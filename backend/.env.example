# RegNav Backend Environment Configuration
#
# Copy to `.env` for local development. Production values come from
# Azure Key Vault via Managed Service Identity — never commit real
# secrets to this file.

APP_NAME=RegNav API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Frontend dev server origins (comma-separated JSON array works too)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://regnav:regnav@localhost:5432/regnav
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Azure AD B2C (leave blank in dev; required in staging/prod)
AZURE_AD_B2C_TENANT=
AZURE_AD_B2C_CLIENT_ID=
AZURE_AD_B2C_POLICY=
JWT_AUDIENCE=
JWT_ALGORITHM=RS256

# Azure resources
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/
AZURE_OPENAI_ENDPOINT=

# Anthropic (used as fallback if Azure Key Vault is not configured)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Observability
LOG_LEVEL=INFO
LOG_JSON=true

# OpenTelemetry — enable to ship traces. Falls back to no-op when disabled.
# For Azure Application Insights, point OTEL_EXPORTER_OTLP_ENDPOINT at the
# Azure Monitor OTLP ingestion endpoint and supply the connection-string
# fragments via OTEL_EXPORTER_OTLP_HEADERS.
# For local dev with docker-compose, the Jaeger collector exposes
# http://jaeger:4318/v1/traces (see docker-compose.yml --profile=otel).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=regnav-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
